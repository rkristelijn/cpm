id: SH-QUAL-020
title: curl without --fail flag
category: quality
severity: warning
engine: pattern
target:
  extensions: .sh
  exclude_paths: test/ node_modules/ vendor/
  content_contains: curl
patterns:
  - regex: curl\s+(?!.*--fail)(?!.*-f\b).*https?://
    message: "curl without --fail or -f — will silently succeed on HTTP errors (404, 500)"
fix: "Add --fail (or -fsSL) to curl invocations to fail on HTTP errors."
