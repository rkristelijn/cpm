id: A11Y-114
title: Target-blank-no-rel
category: a11y
severity: warning
engine: presence
target:
  extensions: .html .htm .jsx .tsx .vue .svelte
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: target=
patterns:
  - regex: target=["']_blank["']
    message: target=_blank found — warn users link opens in new window
fix: Add rel="noopener" and inform users the link opens in a new tab
