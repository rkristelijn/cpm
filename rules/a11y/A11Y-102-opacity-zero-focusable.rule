id: A11Y-102
title: opacity-zero-focusable
category: a11y
severity: warning
engine: pattern
target:
  extensions: .css .scss .less
  exclude_paths: test/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: opacity
patterns:
  - regex: opacity:\s*0[;\s]
    message: opacity:0 may hide focusable elements — creates invisible tab stops
fix: Use visibility:hidden or display:none to properly remove from tab order
