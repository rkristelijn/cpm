id: OAUTH-011
title: OAuth client secret in frontend code
category: security
severity: error
engine: pattern
target:
  extensions: .tsx .jsx .vue .svelte
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/
patterns:
  - regex: client_?[Ss]ecret
    message: "Client secret in frontend code — visible to all users via browser DevTools. Use PKCE for public clients."
fix: Never embed client secrets in SPAs. Use PKCE flow (public clients) or a backend proxy.