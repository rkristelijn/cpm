id: MIG-020
title: DROP TABLE without IF EXISTS
category: quality
severity: error
engine: pattern
target:
  extensions: .sql
  exclude_paths: test/ tests/ .git/ vendor/ node_modules/ seed/
  content_contains: DROP TABLE
patterns:
  - regex: DROP\s+TABLE\s+[a-zA-Z_"]
    message: "DROP TABLE — add IF EXISTS to prevent migration failures on re-run"
fix: Use DROP TABLE IF EXISTS table_name instead of DROP TABLE table_name.
