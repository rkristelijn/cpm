id: RS-SEC-016
title: Panic in library code
category: security
severity: warning
engine: pattern
target:
  extensions: .rs
  exclude_paths: test/ tests/ vendor/ target/ .git/
  content_contains: panic!
patterns:
  - regex: \bpanic!\(
    message: panic! in library crashes the consumer — return Result instead
fix: Replace panic!() with Result<T, E> and use the ? operator for error propagation
