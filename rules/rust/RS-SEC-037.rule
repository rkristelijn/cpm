id: RS-SEC-037
title: Logging secrets
category: security
severity: error
engine: pattern
target:
  extensions: .rs
  exclude_paths: test/ tests/ vendor/ target/ .git/
  content_contains: info!
patterns:
  - regex: (log::|tracing::)(debug|info|warn|error)!.*\b(password|secret|token|key|credential)
    message: Logging potentially sensitive data — secrets must never appear in log output
fix: Remove sensitive fields from log statements, or use a redacting formatter
