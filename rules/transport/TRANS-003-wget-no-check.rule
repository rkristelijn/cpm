id: TRANS-003
title: wget with --no-check-certificate skips TLS verification
category: transport
severity: error
engine: pattern
target:
  extensions: .sh .bash .yml .yaml
  exclude_paths: test/ tests/ vendor/ node_modules/ .git/ build/ dist/
  content_contains: wget
patterns:
  - regex: wget.*--no-check-certificate
    message: "wget with --no-check-certificate — skips TLS verification"
fix: Fix the certificate chain instead of disabling verification. Use --ca-certificate to specify a trusted CA bundle.
